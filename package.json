{
  "name": "fomento",
  "version": "0.1.0",
  "private": true,
  "description": "Fundação local Fomentoria — Bloco A",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "env:check": "node scripts/check-env.mjs",
    "db:ping": "node scripts/db-ping.mjs",
    "docs:gate": "node scripts/check-gate.mjs",
    "verify:static": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:offline": "node --test tests/node/*.test.mjs",
    "compose:up": "docker compose up -d --wait postgres",
    "compose:down": "docker compose down"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  }
}
